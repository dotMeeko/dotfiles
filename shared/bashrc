# ~/.bashrc — managed by dotter. Portable, works without Nix (any distro).
# Keep minimal and cross-distro; machine/OS-specific bits go in templates later.

# History
HISTCONTROL=ignoreboth
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend

# Aliases
alias ll='ls -alh'
alias la='ls -A'
alias gs='git status'
# dotter reads .dotter/global.toml relative to the working directory, so it has
# to run from the repo root — that is what the subshell is for.
alias dot='(cd ~/.dotfiles && dotter)'

# Simple prompt
PS1='\u@\h:\w\$ '
