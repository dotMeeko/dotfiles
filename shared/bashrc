# ~/.bashrc — managed by dotter. Portable, works without Nix (any distro).
# Keep minimal and cross-distro; machine/OS-specific bits go in templates later.

# History
HISTCONTROL=ignoreboth
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend

# Aliases
alias ll='ls -alh'
alias la='ls -A'
alias gs='git status'
# dotter reads .dotter/global.toml relative to the working directory, so it has
# to run from the repo root — that is what the subshell is for.
alias dot='(cd ~/.dotfiles && dotter)'

# Editor. Guarded on the binary existing so this file stays usable on a machine
# where Neovim is not installed — the config in ~/.config/nvim is portable, the
# binary is not something .bashrc can assume.
if command -v nvim >/dev/null 2>&1; then
  export EDITOR=nvim
  export VISUAL=nvim
fi

# Simple prompt
PS1='\u@\h:\w\$ '
