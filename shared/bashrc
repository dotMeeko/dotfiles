# ~/.bashrc — managed by dotter. Portable, works without Nix (any distro).
# Keep minimal and cross-distro; machine/OS-specific bits go in templates later.

# History
HISTCONTROL=ignoreboth
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend

# Aliases
alias ll='ls -alh'
alias la='ls -A'
alias gs='git status'
# dotter reads .dotter/global.toml relative to the working directory, so it has
# to run from the repo root — that is what the subshell is for.
alias dot='(cd ~/.dotfiles && dotter)'

# Editor. Guarded on the binary existing so this file stays usable on a machine
# where Neovim is not installed — the config in ~/.config/nvim is portable, the
# binary is not something .bashrc can assume.
if command -v nvim >/dev/null 2>&1; then
  export EDITOR=nvim
  export VISUAL=nvim
fi

# ~/.local/bin on PATH — user-installed tools; linux/bin scripts deploy there too.
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac

# Machine-local additions that have no place in a public repo (private paths,
# per-box workarounds). Not managed by dotter; absent on most machines.
[ -f "$HOME/.bashrc.local" ] && . "$HOME/.bashrc.local"

# Simple prompt
PS1='\u@\h:\w\$ '
