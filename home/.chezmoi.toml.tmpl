# Bootstrap config for chezmoi itself. Rendered ONCE by `chezmoi init` into
# ~/.config/chezmoi/chezmoi.toml, which is machine-local and never committed —
# every answer here differs per machine or per network.

# Keeps a non-default source location working. `chezmoi init <repo>` clones to
# ~/.local/share/chezmoi, but this repo is normally cloned elsewhere (install.sh
# uses ~/.dotfiles) and that path has to be recorded or chezmoi looks in the
# default spot and finds an empty source.
#
# `dir` strips the .chezmoiroot component: .chezmoi.sourceDir is <repo>/home, so
# its parent is the repo root. Correct in both layouts, including the default one.
sourceDir = {{ .chezmoi.sourceDir | dir | quote }}
{{- if eq .chezmoi.os "linux" }}

[data]
# Address of the machine running the Deskflow server — the Mac. Consumed by
# .config/waynergy/config.ini.tmpl.
#
# Asked instead of committed for two reasons: this repo is public, and the answer
# is network-specific. Asked at all because without it `chezmoi init --apply` on
# a fresh machine dies on that template with
#   template: executing at <.deskflowServer>: map has no entry for key
# and lays down nothing — verified, not assumed.
#
# promptStringOnce only asks when the value is missing, so re-running
# `chezmoi init` on an already configured machine stays silent.
#
# The empty default is deliberate: without one, prompt*Once insists on a TTY and
# `chezmoi init` dies outright wherever there is none — an installer, a script, a
# provisioning run. Empty means waynergy gets `host =`, fails to connect and
# keeps retrying, while every other dotfile still lands. A broken KVM beats a
# dotfiles deployment that laid down nothing. Fill it in later by editing
# ~/.config/chezmoi/chezmoi.toml or re-running `chezmoi init --prompt`.
#
# Linux-only because .chezmoiignore drops .config/waynergy on macOS and Windows,
# where the template is never rendered and the question would be pure noise.
deskflowServer = {{ promptStringOnce . "deskflowServer" "Deskflow server address (the Mac), e.g. 192.168.1.10" "" | quote }}
{{- end }}
