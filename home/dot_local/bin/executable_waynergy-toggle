#!/usr/bin/env bash
# Toggle the Mac's keyboard/mouse sharing on this machine.
#
# waynergy has no GUI of its own — it is a headless Synergy-protocol client — so
# this script is the on/off switch. It is deliberately NOT enabled at login:
# sharing stays off until asked for.
#
# Feedback goes through DankMaterialShell's own notification IPC; notify-send is
# not installed on this system.
set -euo pipefail

unit=waynergy.service

notify() {
	if command -v dms >/dev/null 2>&1; then
		dms ipc notif send "Keyboard sharing" "$1" >/dev/null 2>&1 || true
	fi
	echo "$1"
}

if systemctl --user is-active --quiet "$unit"; then
	systemctl --user stop "$unit"
	notify "Off — this machine no longer accepts the Mac's keyboard and mouse."
else
	systemctl --user start "$unit"
	# Give it a moment to reach the server before reporting success.
	sleep 2
	if systemctl --user is-active --quiet "$unit"; then
		notify "On — accepting keyboard and mouse from the Mac."
	else
		notify "Failed to start. Check: journalctl --user -u $unit -n 20"
		exit 1
	fi
fi
