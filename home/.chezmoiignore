# Per-OS include/exclude, templated by chezmoi. On this machine, files meant for
# other operating systems are ignored (so one source tree serves all OSes).

{{- if ne .chezmoi.os "windows" }}
# Windows-only trees (ignored entirely when not on Windows)
Documents
AppData
{{- end }}

{{- if ne .chezmoi.os "linux" }}
# Linux-only: niri is a Wayland compositor, systemd user units and the waynergy
# toggle exist nowhere else, and .local/share/applications is the XDG desktop-entry
# path (macOS and Windows have their own).
.config/niri
.config/systemd
.config/waynergy
.local/bin/waynergy-toggle
.local/share/applications
{{- end }}
