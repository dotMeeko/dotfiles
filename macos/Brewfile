# Brewfile — macOS packages, installed with `brew bundle --file ~/…/Brewfile`.
# macOS uses Homebrew (no Nix); configs still come from dotter.

tap "homebrew/bundle"

# CLI
brew "git"
brew "neovim"
brew "dotter"
brew "ripgrep"
brew "fzf"
brew "fd"
brew "jq"

# Apps
cask "firefox"
cask "ghostty"

# Zen — the same browser the other two OSes get, so all three stay in step:
# cask 1.24.1b here, Zen-Team.Zen-Browser 1.24.1b on winget, and the flake in
# nix/home/packages.nix pins the same release.
#
# The cask is "zen", NOT "zen-browser" — that name 404s. And winget carries a
# separate "Twilight" version, which is Zen's nightly channel; the numbered
# releases are the public ones (they are published with prerelease=false).
cask "zen"

# NOT HERE, on purpose: Deskflow, the keyboard/mouse server this Mac runs for the
# NixOS box. It has no Homebrew package at all — checked, both `deskflow` cask and
# formula are 404, and so are `synergy` and `input-leap`. Install the .dmg from
# https://github.com/deskflow/deskflow/releases by hand, then grant it BOTH
# Accessibility and Input Monitoring in System Settings -> Privacy & Security.
# Input Monitoring is the one that matters for keys: without it the mouse still
# forwards while keystrokes stay on the Mac, and nothing is logged anywhere.
# Server options to apply afterwards live in macos/deskflow-server-options.conf.
