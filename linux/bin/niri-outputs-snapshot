#!/usr/bin/env bash
# Freeze the CURRENT monitor layout into KDL `output` blocks for config.kdl.
#
# Why this exists. Display changes in this setup are always runtime-only, by
# design and from two directions at once:
#
#   * DMS applies its display settings over IPC and through `dms/outputs.kdl`,
#     a file linux/niri/config.kdl deliberately does not include — see the long
#     comment at the bottom of that file for what granting it cost in 2026-11.
#   * `niri msg output` is documented as "Change output configuration
#     temporarily"; niri intentionally never writes IPC changes back to
#     config.kdl.
#
# So: tune the monitors however you like — the shell's own display panel, `niri
# msg output`, wdisplays — then run this to turn the result into config you can
# paste into linux/niri/config.kdl and commit. GUI for the fiddling, the repo
# for the truth, and nothing writing to config.kdl behind your back.
#
# Prints to stdout and changes nothing. Piping it into the config is on you.
set -euo pipefail

if ! command -v niri >/dev/null 2>&1; then
	echo "niri not on PATH" >&2
	exit 1
fi
if [ -z "${NIRI_SOCKET:-}" ]; then
	echo "NIRI_SOCKET unset — run this from inside a niri session" >&2
	exit 1
fi

niri msg --json outputs | python3 -c '
import json, sys

outs = json.load(sys.stdin)
if not outs:
    sys.exit("niri reported no outputs")

# Sorted by logical x so the printed order matches what you see left to right.
# Cosmetic only: niri places outputs itself, and nothing below pins a position.
items = sorted(
    outs.items(),
    key=lambda kv: (kv[1].get("logical") or {}).get("x", 0),
)

print("// Generated by linux/bin/niri-outputs-snapshot — the layout as it was")
print("// running, not as it was configured. Check each block before keeping it.")
print()

for name, o in items:
    logical = o.get("logical")
    idx = o.get("current_mode")

    if logical is None or idx is None:
        print(f"// {name}: disabled or no current mode — skipped")
        print()
        continue

    mode = o["modes"][idx]
    # Pulled out into locals rather than indexed inside the f-strings below:
    # this whole program is passed to python3 -c inside a single-quoted shell
    # string, so an apostrophe anywhere in it ends that string and the quotes
    # vanish silently. mode["width"] became mode[width] and the script died on
    # a NameError. Keep every dict key out of the f-strings.
    width = mode["width"]
    height = mode["height"]
    # niri wants the refresh rate with three decimals, as it prints it in
    # `niri msg outputs`; refresh_rate here is millihertz.
    refresh = mode["refresh_rate"] / 1000.0
    scale = logical.get("scale", 1.0)
    # 1.0 -> "1": niri accepts both, and an integer scale reads as deliberate
    # rather than as a leftover from something that computed it.
    scale_str = str(int(scale)) if float(scale).is_integer() else f"{scale:g}"
    transform = logical.get("transform", "Normal")

    desc = " ".join(str(o[k]) for k in ("make", "model") if o.get(k)).strip()
    print(f"// {desc}" if desc else f"// {name}")
    print(f"output \"{name}\" {{")
    print(f"    mode \"{width}x{height}@{refresh:.3f}\"")
    print(f"    scale {scale_str}")
    if transform != "Normal":
        # niri spells these lowercase/hyphenated ("90", "flipped-90"); the IPC
        # returns CamelCase. Flagged rather than guessed at.
        print(f"    // transform reported as {transform} — add `transform` by hand")
    if o.get("vrr_enabled"):
        print("    variable-refresh-rate")
    print("}")

    # NO `position`, and this is the point of the whole file rather than an
    # oversight. A pinned position puts a lone connected monitor at its
    # dual-layout slot: DP-3 at x=3072 with the 4K off left a 3072 px phantom
    # gap, waynergy measured the screen as the bounding box FROM ZERO, reported
    # 4992 px for a 1920 px panel, and the remote mouse crawled at 1920/4992
    # speed. niri auto-places left to right with no gaps, whichever monitors
    # happen to be plugged in.
    x = logical.get("x", 0)
    y = logical.get("y", 0)
    print(f"// position was {x},{y} — intentionally NOT emitted; see config.kdl")
    print()
'
