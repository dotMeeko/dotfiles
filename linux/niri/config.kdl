input {
    keyboard {
        xkb {
            layout "us,ru"
            // Layout switching is done by the niri bind Mod+Space (see binds
            // below), NOT by an xkb `grp:*_toggle` option. That choice is the
            // result of hitting both failure modes in turn:
            //
            //   both at once  -> the key gets handled TWICE. niri runs its bind
            //                    AND still feeds the key to the xkb state machine,
            //                    so the layout flipped and flipped back and looked
            //                    completely dead. This is what DMS caused by
            //                    setting win_space_toggle behind our back.
            //   xkb option only -> the layout switches, but nothing CONSUMES the
            //                    keypress, so Space also reaches the focused window
            //                    and types a space on every switch.
            //   niri bind only -> correct: one switch, and the bind swallows the key.
            //
            // The old warning here claimed a niri bind cannot do this because
            // Mod+Space stops matching once a non-Latin layout is active. Tested
            // directly, in both directions: switching away from Russian works. That
            // concern is real for LETTER binds, whose keysym changes with the
            // layout, and simply does not apply to Space.
            //
            // Empty on purpose — anything here would fight the bind.
            options ""
            model ""
            rules ""
            variant ""
        }
        repeat-delay 600
        repeat-rate 25
        track-layout "global"
    }
    touchpad {
        tap
        natural-scroll
    }
}
// Monitors, owned HERE and nowhere else. DMS used to own them through its
// per-monitor-set profiles, and it stays locked out of them on purpose: no
// `dms/outputs.kdl` include at the bottom of this file, and its auto-apply left
// off (both explained there).
//
// Mode and scale only — NO `position`, and that omission is the point. DMS wrote
// positions (DP-3 at x=3072, its slot right of the 4K) and kept applying that
// profile even while the 4K was unplugged, leaving a 3072 px phantom gap in the
// layout. waynergy measures the screen as the bounding box FROM ZERO, so it then
// reported 4992 px wide for a 1920 px panel and the remote mouse crawled at
// 1920/4992 of its proper speed. niri's own left-to-right auto-placement never
// leaves a gap, whichever monitors happen to be connected, so the whole failure
// mode is designed out rather than worked around.
//
// Worth knowing for the scale 1.25 below: DMS computed neighbour offsets with
// floor() on the logical width while niri uses ceil(), so a fractionally scaled
// monitor overlapped its neighbour by 1 px and niri — which auto-places
// overlapping outputs elsewhere — threw the layout across the desk. Fixed
// upstream (dux-shell#3875, "ceil logical output sizes on niri"), and with no
// positions here it cannot bite anyway. Two independent reasons, not one.
//
// The cost of dropping positions: with both monitors on, their left-to-right
// order is whatever niri discovers. Fix it live with `niri msg output ...` if it
// ever comes out wrong — do NOT pin positions back here.
output "DP-3" {
    mode "1920x1080@120.000"
    scale 1
}

output "DP-2" {
    // 143.963, not the 59.997 this said until 2026-11-17, and not an EDID
    // reading either: 59.997 is merely the mode the panel calls `preferred`,
    // which is what niri falls back to and what DMS pinned. The 144 Hz mode was
    // being set at RUNTIME — by the niri-displays plugin, whose changes go
    // through `niri msg output` and which niri deliberately never writes back
    // to config.kdl. So the repo quietly said 60 while the desk ran 144, and
    // the next session restart would have "fixed" it down to 60.
    //
    // Caught by linux/bin/niri-outputs-snapshot, which exists for exactly this
    // class of drift. Run it after any display fiddling.
    mode "3840x2160@143.963"
    // 4K at 1:1 is unusably small. 3840/1.25 = 3072 logical px, which is what
    // niri reports, so this one was in sync.
    scale 1.25
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
layout {
    gaps 16
    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
    focus-ring { width 4; }
    border { off; }
    default-column-width
    center-focused-column "never"
}
cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}
binds {
    // Shell controls — DMS (Dux Modular Shell), driven over `dms ipc`. Written
    // out by hand here rather than taken from the shell's home-manager module:
    // that module adds them to programs.niri.settings, and this file is the one
    // that actually reaches disk (niri-flake's output is force-disabled — see
    // nix/modules/home.nix for the full reason).
    //
    // The launcher stays on Alt+Space, NOT the Mod+Space the module would set.
    // Mod+Space is the keyboard-layout toggle (see the keyboard block above);
    // binding the launcher onto the same key fires both on one press, which is
    // exactly the double-handling bug that made layout switching look broken.
    Mod+Space hotkey-overlay-title="Switch Keyboard Layout" { switch-layout "next"; }
    Alt+Space hotkey-overlay-title="Toggle Application Launcher" { spawn "dms" "ipc" "spotlight" "toggle"; }
    Mod+V hotkey-overlay-title="Toggle Clipboard Manager" { spawn "dms" "ipc" "clipboard" "toggle"; }
    Mod+X hotkey-overlay-title="Toggle Power Menu" { spawn "dms" "ipc" "powermenu" "toggle"; }
    Mod+Comma hotkey-overlay-title="Toggle Settings" { spawn "dms" "ipc" "settings" "toggle"; }
    Mod+N hotkey-overlay-title="Toggle Notification Center" { spawn "dms" "ipc" "notifications" "toggle"; }
    Super+Alt+L hotkey-overlay-title="Toggle Lock Screen" { spawn "dms" "ipc" "lock" "lock"; }
    Mod+Alt+N allow-when-locked=true hotkey-overlay-title="Toggle Night Mode" { spawn "dms" "ipc" "night" "toggle"; }

    // Back with DMS, and the two bindings the Noctalia spell cost us: the
    // process list needs enableSystemMonitoring (set in nix/modules/home.nix),
    // the notepad is built in and needs nothing.
    Mod+M hotkey-overlay-title="Toggle Process List" { spawn "dms" "ipc" "processlist" "toggle"; }
    Mod+P hotkey-overlay-title="Toggle Notepad" { spawn "dms" "ipc" "notepad" "toggle"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "dms" "ipc" "audio" "increment" "3"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "dms" "ipc" "audio" "decrement" "3"; }
    XF86AudioMute allow-when-locked=true { spawn "dms" "ipc" "audio" "mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "dms" "ipc" "audio" "micmute"; }
    // The trailing "" is not a typo and not padding — it is the output argument,
    // and the shell's own niri module passes it exactly like this. Omitting it
    // makes the step the output name.
    XF86MonBrightnessUp allow-when-locked=true { spawn "dms" "ipc" "brightness" "increment" "5" ""; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "dms" "ipc" "brightness" "decrement" "5" ""; }
    XF86TouchpadToggle allow-when-locked=true repeat=false { spawn "niri" "msg" "action" "toggle-touchpad"; }

    // ─── Окна и приложения ───────────────────────────────────────────────
    Mod+Return hotkey-overlay-title="Open a Terminal" { spawn "ghostty"; }
    Mod+Q hotkey-overlay-title="Close Window" { close-window; }
    Mod+Shift+Slash hotkey-overlay-title="Show Hotkey Overlay" { show-hotkey-overlay; }
    Mod+Shift+E hotkey-overlay-title="Quit niri" { quit; }

    // ─── Фокус ───────────────────────────────────────────────────────────
    // niri колоночный: H/L ходят между колонками, J/K — между окнами внутри колонки.
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    // ─── Перемещение ─────────────────────────────────────────────────────
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }

    // ─── Размеры и структура колонок ─────────────────────────────────────
    Mod+R hotkey-overlay-title="Cycle Column Width" { switch-preset-column-width; }
    Mod+F hotkey-overlay-title="Maximize Column" { maximize-column; }
    Mod+Shift+F hotkey-overlay-title="Fullscreen" { fullscreen-window; }
    Mod+C hotkey-overlay-title="Center Column" { center-column; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+BracketLeft  hotkey-overlay-title="Consume/Expel Left" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="Consume/Expel Right" { consume-or-expel-window-right; }

    // ─── Воркспейсы ──────────────────────────────────────────────────────
    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // ─── Мониторы (DP-2 + DP-3) ──────────────────────────────────────────
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+Shift+H { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+L { move-column-to-monitor-right; }

    // ─── Floating и оверврю ──────────────────────────────────────────────
    Mod+Shift+Space hotkey-overlay-title="Toggle Floating" { toggle-window-floating; }
    Mod+Ctrl+Space hotkey-overlay-title="Floating/Tiling Focus" { switch-focus-between-floating-and-tiling; }
    Mod+O hotkey-overlay-title="Toggle Overview" { toggle-overview; }

    // ─── Скриншоты ───────────────────────────────────────────────────────
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
}
spawn-at-startup "dms" "run"

// Kept from the Noctalia setup, where it was needed for notification actions and
// window activation: a shell that activates a window with a serial niri calls
// stale gets its request refused without this. DMS raises windows the same way
// from its notifications and its process list, so the flag stays. Checked
// against niri 26.04; harmless if the shell never needs it.
debug {
    honor-xdg-activation-with-invalid-serial
}

// ── No `include` lines here, and that is a decision, not an omission ────────
//
// DMS keeps its generated kdl in ~/.config/niri/dms/ — colors, layout, alttab,
// cursor, windowrules, wpblur, binds-next, binds, outputs — and each only takes
// effect if this file includes it. Its home-manager module would write all of
// them (includes.enable, default filesToInclude); it is off in
// nix/modules/home.nix. None are granted here either, because every one of the
// 2026-11-05 failures came in through this door:
//
//   outputs.kdl + its monitor profiles -> DP-3 pinned at x=3072 while the 4K was
//       unplugged, a 3072 px phantom gap, remote mouse at 1920/4992 speed.
//   input.kdl -> the shell regenerated it from its own keyboardOptions and set
//       grp:win_space_toggle behind our back, so the layout flipped twice per
//       press and looked dead. The fix is above: an empty xkb `options` plus the
//       Mod+Space bind, which cannot be overridden by a file nobody includes.
//
// Monitors live in the `output` blocks above, keybinds in `binds` above. Both
// are this file's, in the repo, under dotter.
//
// Two things to know rather than discover:
//
// 1. The shell can still append an include itself the first time its settings UI
//    wants to own something. This file is a dotter SYMLINK into the repo, so
//    that shows up as a diff in `git status` — visible and revertible, which is
//    the entire reason niri stays at 26.04 (25.08 cannot parse `include` at all
//    and would just kill the session). If a line appears: delete it, and change
//    the setting that provoked it.
// 2. Display profiles are applied over IPC, not through a file, so skipping the
//    include does not by itself stop them. What does: `displayProfileAutoSelect`
//    defaults to FALSE in 2.1.2 (checked in the shell's SettingsSpec, not
//    assumed) — the auto-reapply that caused the phantom gap is off unless
//    switched on. Verify on a live shell with `dms ipc outputs status`; the
//    switch is `dms ipc outputs toggleAuto`. Leave it off.
