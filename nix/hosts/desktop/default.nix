# Role `desktop` — graphical workstation (Niri + NVIDIA), GRUB bootloader.
# Machine name (machine.nix), user name (user.nix), hardware (hardware-configuration.nix)
# and disk layout (disko.nix) are generated by the installer. All imported only when
# present, so eval / build-vm work before they exist.
{ config, lib, ... }:
{
  imports =
    [
      ../../modules/base.nix
      ../../modules/desktop-niri.nix
      ../../modules/gpu-nvidia.nix
      ../../modules/snapshots.nix
    ]
    ++ lib.optional (builtins.pathExists ./hardware-configuration.nix) ./hardware-configuration.nix
    ++ lib.optional (builtins.pathExists ./machine.nix) ./machine.nix
    ++ lib.optional (builtins.pathExists ./user.nix) ./user.nix;

  # Bootloader: GRUB (EFI). os-prober adds Windows to the menu (dual-boot); NixOS
  # generations appear automatically — selecting an older one = system rollback.
  boot.loader.grub = {
    enable = true;
    efiSupport = true;
    device = "nodev";
    useOSProber = true;
    configurationLimit = 20;
  };
  boot.loader.efi.canTouchEfiVariables = true;

  # build-vm only: headless, WSL2-friendly, throwaway login password.
  # Does not affect the real system.
  virtualisation.vmVariant = {
    users.users.${config.my.username}.hashedPasswordFile = lib.mkForce null;
    users.users.${config.my.username}.initialPassword = "changeme";
    virtualisation = {
      graphics = false; # serial console (ttyS0) so the boot can be read headless
      useNixStoreImage = true; # avoid WSL2's unreliable virtiofs host-store share
      writableStore = true; # writable store overlay so HM / nix-path registration works
    };
  };
}
